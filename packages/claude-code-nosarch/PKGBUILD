# Maintainer: NosArch
#
# nosarch-upstream: github anthropics/claude-code

pkgname=claude-code-nosarch
pkgdesc="Claude Code - Anthropic's agentic coding tool for the terminal"
pkgver=2.1.299
pkgrel=1
url="https://code.claude.com/docs/en/overview"
license=('LicenseRef-Anthropic-Commercial-TOS')

arch=('x86_64')
depends=('bash' 'glibc')
options=('!strip' '!debug')
provides=('claude-code')
conflicts=('claude-code')
source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/anthropics/claude-code/releases/download/v$pkgver/claude-linux-x64.tar.gz"
    "LICENSE.md::https://raw.githubusercontent.com/anthropics/claude-code/v$pkgver/LICENSE.md"
    "claude-wrapper.sh"
)
sha256sums=('053ff263ea005565625d8e94e15a1beb3b0dc46f7578ba15984c9ab9e17137be'
            '728158fd1037143fad6907e8fa34804177e598b7326519503fe83cafdef849e6'
            '94381829093f800d88686fc7d3cbee22de931ac7c2b17dceca3e8f7bf1750c63')

package() {
    install -Dm755 "$srcdir/claude" "$pkgdir/opt/$pkgname/claude"

    # Self-update block:
    # DISABLE_UPDATES stops the background auto-updater; `claude update`, `upgrade`, and `install` are refused by name.
    install -Dm755 "$srcdir/claude-wrapper.sh" "$pkgdir/usr/bin/claude"

    install -Dm644 "$srcdir/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
