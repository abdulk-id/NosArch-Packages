# Maintainer: NosArch
#
# nosarch-upstream: github google-antigravity/antigravity-cli

pkgname=antigravity-cli-nosarch
pkgdesc="Antigravity CLI - Google's terminal AI coding agent"
pkgver=1.3.3
pkgrel=2
url="https://antigravity.google/product/antigravity-cli"
license=('LicenseRef-Antigravity-CLI')

arch=('x86_64')
# bash: /bin/sh for the /usr/bin/agy wrapper
depends=('bash' 'glibc')
options=('!strip' '!debug')
provides=('antigravity-cli' 'agy')
conflicts=('antigravity-cli' 'agy')
source=(
    "agy_cli_linux_x64.tar.gz::https://github.com/google-antigravity/antigravity-cli/releases/download/$pkgver/agy_cli_linux_x64.tar.gz"
    "LICENSE"
    "agy-wrapper.sh"
)
sha256sums=('8ee3ca32574c431285efbf4d4732f7f8d53e959370bc4a61646e4fa496f7f2b6'
            '4eec67c0a77ba5d8a696a52d76db8c05a7d265d03cf2ea63fc089187079989bc'
            'e014da596840c410830661bddc51a9b35eac1a39e8ff20769dc61037b8937734')

package() {
    install -Dm755 "$srcdir/antigravity" "$pkgdir/opt/$pkgname/agy"

    # Self-update block:
    # AGY_CLI_DISABLE_AUTO_UPDATE is Google's documented opt-out; `agy update` is refused by the wrapper.
    # The real binary lives under root-owned /opt so a user-level self-replace cannot write there.
    install -Dm755 "$srcdir/agy-wrapper.sh" "$pkgdir/usr/bin/agy"

    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
