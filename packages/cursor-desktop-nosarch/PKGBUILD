# Maintainer: NosArch
#
# nosarch-upstream: json https://cursor.com/api/download?platform=linux-x64&releaseTrack=stable version

pkgname=cursor-desktop-nosarch
pkgdesc="AI-First Coding environment"
pkgver=3.26.16
pkgrel=1
url="https://cursor.com"
license=('LicenseRef-Cursor-EULA')

arch=('x86_64')
depends=('alsa-lib' 'at-spi2-core' 'bash' 'cairo' 'cups' 'dbus' 'expat' 'gcc-libs' 'glib2' 'gtk3'
         'libxcb' 'libx11' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon'
         'libxkbfile' 'libxrandr' 'mesa' 'nodejs' 'nspr' 'nss' 'pango' 'systemd-libs' 'xdg-utils')
options=('!strip' '!debug')
provides=('cursor')
conflicts=('cursor' 'cursor-bin' 'cursor-appimage' 'cursor-nosarch')
_commit=8fcb8ace5c73fa31f2e2707fd6783160e4ed3e49
source=(
    "$pkgname-$pkgver.deb::https://downloads.cursor.com/production/$_commit/linux/x64/deb/amd64/deb/cursor_${pkgver}_amd64.deb"
    "cursor-agent-no-selfinstall.patch"
)
sha256sums=('c2e8a604e343bb72571d07f6c148e09e124250b3e5333b13f115254272671045'
            '66542723a9f39f68da64610cc895a54d9f4a59175b86e05b0ae2048661ffbb29')

package() {
    # Unpack the Debian payload with libarchive (pacman's own dependency; reads .xz natively), preserving upstream's
    # FHS layout: /usr/share/cursor, the desktop entries, the pixmap icon and the shipped bash completion.
    bsdtar -xf "$srcdir/$pkgname-$pkgver.deb" -C "$srcdir"
    bsdtar -xf "$srcdir/data.tar.xz" -C "$pkgdir"

    # The deb's postinst never runs under pacman, and it is what creates this symlink.
    install -d "$pkgdir/usr/bin"
    ln -s /usr/share/cursor/bin/cursor "$pkgdir/usr/bin/cursor"

    # Self-update block:
    # The launcher's `cursor agent` would curl-pipe-bash into ~/.local/bin; the patch routes to cursor-cli-nosarch.
    patch --directory="$pkgdir" --strip=1 --no-backup-if-mismatch \
        --input="$srcdir/cursor-agent-no-selfinstall.patch"

    install -Dm644 "$pkgdir/usr/share/cursor/resources/app/LICENSE.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
