# Maintainer: NosArch
#
# nosarch-upstream: github pingdotgg/t3code

pkgname=t3code-cli-nosarch
pkgdesc="Run the T3 Code server and web client"
pkgver=0.0.45
pkgrel=1
url="https://t3.codes"
license=('MIT')

arch=('x86_64')
depends=('bash' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'shadow')
# shadow: runuser in the libalpm hook helper
options=('!strip' '!debug')
source=(
    "t3-$pkgver-linux-x64.tar.gz::https://github.com/pingdotgg/t3code/releases/download/v$pkgver/t3-$pkgver-linux-x64.tar.gz"
    "LICENSE::https://raw.githubusercontent.com/pingdotgg/t3code/v$pkgver/LICENSE"
)
sha256sums=(
    '10505ae74bc6a43cfab0fde0bf06a0e0d6862f74030591be994a640d48a0d6bd'
    '935d8f2af0c703f9c39517ee57cc4930b19d02d533be930b63f0e82f93614b43'
)

package() {
    # Keep the tree intact: t3 resolves client/, node_modules/ and resource-monitor/ as siblings of its own realpath
    # (the installer's symlink layout relies on this).
    install -d "$pkgdir/opt/$pkgname"
    cp -a --no-preserve=ownership "$srcdir/t3-$pkgver-linux-x64/." "$pkgdir/opt/$pkgname/"

    # Windows-only winpty build scripts (shell/python) pull bash and python into namcap's depends analysis. node-pty
    # never touches them at runtime on Linux.
    rm -rf "$pkgdir/opt/$pkgname/node_modules/node-pty/deps/winpty"

    # Block self-update paths that would move the service off the pacman-managed version (t3 update repoints
    # t3code.service at a GitHub-pinned runtime). repointLauncher already leaves /usr/bin/t3 alone; this refuses the
    # command so PATH stays authoritative. Everything else execs the real binary.
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/t3" <<'EOF'
#!/bin/sh
case "${1:-}" in
    update|uninstall)
        echo "t3 $1 is blocked: this install is managed by pacman (t3code-cli-nosarch)." >&2
        echo "Update or remove the package with pacman instead." >&2
        exit 1
        ;;
esac
exec /opt/t3code-cli-nosarch/t3 "$@"
EOF

    # Lifecycle is owned by the official `t3 service install` unit (t3code.service) or any other already-running t3
    # server. This package only opens the UI and offers desktop entries for that unit, never starts an orphan process.
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/t3code-web" <<'EOF'
#!/bin/sh
# Control the official T3 Code background service and open the web UI.
# Never spawns a bare `t3 start`. It stacks processes with no stop path.

set -eu

unit=t3code.service
runtime="${T3CODE_HOME:-$HOME/.t3}/userdata/server-runtime.json"

notify() {
    msg=$1
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u critical "T3 Code" "$msg" 2>/dev/null || echo "$msg" >&2
    else
        echo "$msg" >&2
    fi
}

# Prints origin if a live server (service, desktop app, or anything) wrote
# server-runtime.json and its pid is still alive.
live_origin() {
    [ -f "$runtime" ] || return 1
    pid=$(sed -n 's/.*"pid":[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$runtime")
    origin=$(sed -n 's/.*"origin":"\([^"]*\)".*/\1/p' "$runtime")
    [ -n "${pid:-}" ] && [ -n "${origin:-}" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    printf '%s\n' "$origin"
}

wait_for_origin() {
    i=0
    while [ "$i" -lt 50 ]; do
        if origin=$(live_origin); then
            return 0
        fi
        i=$((i + 1))
        sleep 0.1
    done
    return 1
}

open_ui() {
    origin=$(live_origin) || {
        notify "T3 Code server is not running. Use the Start T3 Code Service menu entry."
        exit 1
    }
    exec xdg-open "$origin"
}

start_service() {
    if ! systemctl --user start "$unit" 2>/dev/null; then
        systemctl --user daemon-reload
        systemctl --user reset-failed "$unit" 2>/dev/null || true
        if ! systemctl --user start "$unit" 2>/dev/null; then
            notify "t3code.service is not installed. Run: t3 service install"
            exit 1
        fi
    fi
    if wait_for_origin; then
        exec xdg-open "$origin"
    fi
    notify "T3 Code service started but no server appeared yet. Check: t3 service status"
    exit 1
}

stop_service() {
    if ! systemctl --user stop "$unit" 2>/dev/null; then
        notify "t3code.service is not installed or not loaded. Run: t3 service install"
        exit 1
    fi
}

status_service() {
    exec systemctl --user status "$unit"
}

case "${1:-open}" in
    open|"")
        open_ui
        ;;
    start)
        start_service
        ;;
    stop)
        stop_service
        ;;
    status)
        status_service
        ;;
    *)
        echo "usage: t3code-web [open|start|stop|status]" >&2
        exit 2
        ;;
esac
EOF

    # Hook helper: runs as root from libalpm. Installs/removes the official per-user t3code.service for every human
    # account (single-user NosArch machines). Failures are warnings only so hooks cannot abort the transaction.
    install -Dm755 /dev/stdin "$pkgdir/usr/lib/t3code-cli-nosarch/service-hook.sh" <<'EOF'
#!/bin/sh
# Pacman hook helper for t3code-cli-nosarch.
# Usage: service-hook.sh install|uninstall

set -u

mode=${1:-}
case "$mode" in
    install|uninstall) ;;
    *)
        echo "usage: service-hook.sh install|uninstall" >&2
        exit 2
        ;;
esac

human_users() {
    # UID >= 1000, home under /home or /var/home (NosArch is single-user; this still
    # covers extra local accounts without touching system/root).
    getent passwd | awk -F: '$3 >= 1000 && $6 ~ /^\/(var\/)?home\// { print $1 }'
}

run_as_user() {
    user=$1
    shift
    uid=$(id -u "$user" 2>/dev/null) || return 1
    home=$(getent passwd "$user" | cut -d: -f6)
    [ -n "$home" ] || return 1

    # systemctl --user needs the runtime dir; linger keeps user@.service alive
    # after logout so install works from a pacman session.
    loginctl enable-linger --no-ask-password "$user" 2>/dev/null || true

    runuser -u "$user" -- env \
        HOME="$home" \
        USER="$user" \
        LOGNAME="$user" \
        XDG_RUNTIME_DIR="/run/user/$uid" \
        PATH="/usr/local/bin:/usr/bin:/bin" \
        t3 service "$mode"
}

status=0
found=0
for user in $(human_users); do
    found=1
    echo "t3code-cli-nosarch: t3 service $mode for $user"
    if ! run_as_user "$user"; then
        echo "t3code-cli-nosarch: t3 service $mode failed for $user (network required on first install)" >&2
        status=1
    fi
done

if [ "$found" -eq 0 ]; then
    echo "t3code-cli-nosarch: no human users found; skipping t3 service $mode"
fi

# Never fail the pacman transaction (PostTransaction ignores exit status anyway;
# PreTransaction without AbortOnFail only reports).
exit 0
EOF

    install -Dm644 /dev/stdin "$pkgdir/usr/share/libalpm/hooks/60-t3code-cli-nosarch-service.hook" <<'EOF'
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = t3code-cli-nosarch

[Action]
Description = Installing T3 Code background service for users...
When = PostTransaction
Exec = /usr/lib/t3code-cli-nosarch/service-hook.sh install
EOF

    install -Dm644 /dev/stdin "$pkgdir/usr/share/libalpm/hooks/60-t3code-cli-nosarch-service-remove.hook" <<'EOF'
[Trigger]
Operation = Remove
Type = Package
Target = t3code-cli-nosarch

[Action]
Description = Removing T3 Code background service for users...
When = PreTransaction
Exec = /usr/lib/t3code-cli-nosarch/service-hook.sh uninstall
EOF

    install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/t3code-server.desktop" <<'EOF'
[Desktop Entry]
Name=T3 Code (Web)
Comment=Open T3 Code in the browser (service must already be running)
Exec=t3code-web open
TryExec=t3code-web
Terminal=false
Type=Application
Icon=t3code-server
Categories=Development;
Actions=start-service;stop-service;

[Desktop Action start-service]
Name=Start T3 Code Service
Icon=t3code-server
Exec=t3code-web start

[Desktop Action stop-service]
Name=Stop T3 Code Service
Icon=t3code-server
Exec=t3code-web stop
EOF

    install -Dm644 "$srcdir/t3-$pkgver-linux-x64/client/favicon-16x16.png" \
        "$pkgdir/usr/share/icons/hicolor/16x16/apps/t3code-server.png"
    install -Dm644 "$srcdir/t3-$pkgver-linux-x64/client/favicon-32x32.png" \
        "$pkgdir/usr/share/icons/hicolor/32x32/apps/t3code-server.png"
    # The CLI ships 16/32 favicons plus a 180x180 apple-touch-icon, which has no hicolor size dir.
    install -Dm644 "$srcdir/t3-$pkgver-linux-x64/client/apple-touch-icon.png" \
        "$pkgdir/usr/share/pixmaps/t3code-server.png"

    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
