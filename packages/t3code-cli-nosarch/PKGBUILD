# Maintainer: NosArch
#
# nosarch-upstream: github pingdotgg/t3code

pkgname=t3code-cli-nosarch
pkgdesc="Run the T3 Code server and web client"
pkgver=0.1.1
pkgrel=1
url="https://t3.codes"
license=('MIT')

arch=('x86_64')
# shadow: runuser in the libalpm hook helper
depends=('bash' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'nodejs' 'shadow')
options=('!strip' '!debug')
source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/pingdotgg/t3code/releases/download/v$pkgver/t3-$pkgver-linux-x64.tar.gz"
    "LICENSE::https://raw.githubusercontent.com/pingdotgg/t3code/v$pkgver/LICENSE"
    "t3-wrapper.sh"
    "t3code-web.sh"
    "service-hook.sh"
    "60-t3code-cli-nosarch-service.hook"
    "60-t3code-cli-nosarch-service-remove.hook"
    "t3code-server.desktop"
)
sha256sums=('33c43ea2f803215662f5a31fdf9e1bca86ab67cac4f2398565c2ba12e17c2185'
            '935d8f2af0c703f9c39517ee57cc4930b19d02d533be930b63f0e82f93614b43'
            'a3921bf3eaa3b2c1aef53c10c1cef3e36371cf202e5acd1d91f00191cc937a32'
            'a3f7381997cd13301675556995f2f00d36bd47fe17bd76b267c43950ad062331'
            'db837f2ba53cf9395fef83de8eccdc3ddec173416e7ee0f1576d70a59d58ba3b'
            '2f05b6dd44ba714bfdfb4d3949403739b4ad886eec8cdc4b0589f67373b687e8'
            '8f0389016b1b5ba3c9490f8a82d860f0828bc28feae07b0c5c67cdc0ca6141e6'
            'd7b713a6e523cab5567d21ce27abca202d0dcf8384fa6dd33dbd3ce2af44fc78')

package() {
    # Keep the tree intact: t3 resolves client/, node_modules/ and resource-monitor/ as siblings of its own realpath
    # (the installer's symlink layout relies on this).
    install -d "$pkgdir/opt/$pkgname"
    cp -a --no-preserve=ownership "$srcdir/t3-$pkgver-linux-x64/." "$pkgdir/opt/$pkgname/"

    # Windows-only winpty build scripts (shell/python) pull bash and python into namcap's depends analysis. node-pty
    # never touches them at runtime on Linux.
    rm -rf "$pkgdir/opt/$pkgname/node_modules/node-pty/deps/winpty"

    # Self-update block:
    # `t3 update` repoints t3code.service at a GitHub runtime; the wrapper refuses update and uninstall by name.
    install -Dm755 "$srcdir/t3-wrapper.sh" "$pkgdir/usr/bin/t3"

    install -Dm755 "$srcdir/t3code-web.sh" "$pkgdir/usr/bin/t3code-web"

    install -Dm755 "$srcdir/service-hook.sh" "$pkgdir/usr/lib/t3code-cli-nosarch/service-hook.sh"
    install -Dm644 "$srcdir/60-t3code-cli-nosarch-service.hook" \
        "$pkgdir/usr/share/libalpm/hooks/60-t3code-cli-nosarch-service.hook"
    install -Dm644 "$srcdir/60-t3code-cli-nosarch-service-remove.hook" \
        "$pkgdir/usr/share/libalpm/hooks/60-t3code-cli-nosarch-service-remove.hook"

    install -Dm644 "$srcdir/t3code-server.desktop" "$pkgdir/usr/share/applications/t3code-server.desktop"

    install -Dm644 "$srcdir/t3-$pkgver-linux-x64/client/favicon-16x16.png" \
        "$pkgdir/usr/share/icons/hicolor/16x16/apps/t3code-server.png"
    install -Dm644 "$srcdir/t3-$pkgver-linux-x64/client/favicon-32x32.png" \
        "$pkgdir/usr/share/icons/hicolor/32x32/apps/t3code-server.png"
    # The CLI ships 16/32 favicons plus a 180x180 apple-touch-icon, which has no hicolor size dir.
    install -Dm644 "$srcdir/t3-$pkgver-linux-x64/client/apple-touch-icon.png" \
        "$pkgdir/usr/share/pixmaps/t3code-server.png"

    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
