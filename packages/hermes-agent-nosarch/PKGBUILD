# Maintainer: NosArch
#
# nosarch-upstream: github NousResearch/hermes-agent

pkgname=hermes-agent-nosarch
pkgdesc="Hermes Agent - self-improving AI agent by Nous Research"
pkgver=0.21.7
pkgrel=2
url="https://github.com/NousResearch/hermes-agent"
license=('MIT')

arch=('x86_64')
# The agent runs from a venv built against the system interpreter, and node runs the prebuilt
# TUI bundle the build assembles. Everything else (ripgrep, ffmpeg, clipboard) it stages into
# ~/.hermes/tools through its own package manager on first use, so those stay optional.
# The rest is what the bundled Chromium behind the desktop app's Electron runtime links against.
depends=('python' 'nodejs' 'git'
         'alsa-lib' 'at-spi2-core' 'avahi' 'cairo' 'dbus' 'fontconfig' 'gdk-pixbuf2'
         'glib2' 'gtk3' 'hicolor-icon-theme' 'libcups' 'libdrm' 'libnotify' 'libsecret' 'libx11'
         'libxcomposite' 'libxcursor' 'libxdamage' 'libxext' 'libxfixes' 'libxi' 'libxinerama'
         'libxkbcommon' 'libxrandr' 'libxrender' 'mesa' 'nspr' 'nss' 'pango' 'util-linux-libs'
         'wayland' 'xdg-utils')
optdepends=(
    'ripgrep: fast file search for the agent tools'
    'ffmpeg: audio and video processing'
    'openssh: ssh tool backend'
    'wl-clipboard: clipboard access for the TUI on Wayland'
    'xclip: clipboard access for the TUI on X11'
    'libayatana-appindicator: tray icon for the desktop app'
    'chromium: local browser automation for the agent tools (or google-chrome)'
    'google-chrome: local browser automation for the agent tools (or chromium)'
)
# matrix pulls python-olm, which compiles a vendored libolm through CFFI and declares a
# cmake_minimum_required older than CMake 4 accepts. npm is a separate package from nodejs on
# Arch, and the TUI/web/desktop builds all drive it. gcc builds node-pty and the desktop app's
# X11 helper. All build-time only.
makedepends=('cmake' 'gcc' 'npm')
options=('!strip' '!debug')
provides=('hermes' 'hermes-agent' 'hermes-desktop' 'hermes-agent-desktop')
conflicts=('hermes' 'hermes-agent' 'hermes-desktop' 'hermes-agent-desktop')
source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/NousResearch/hermes-agent/archive/refs/tags/v$pkgver.tar.gz"
    "hermes-wrapper.sh"
    "hermes-desktop.sh"
    "com.nousresearch.hermes.desktop"
)
sha256sums=('fcf5fc29d3088764a5a293910f75f43dc736b5655ed410d7339cf94cc1462459'
            'b8d4aec2a603a8f2f7278062e0a46d199f60245a8036ade5807fca08dbf32b35'
            '3eba54d3bed890a54b893bcf167d6998960aa37d1b26907da0fddaf10c14d196'
            'a93c298abdfab21d8050c38b0e9179081b1816f35084bc3f21007fe9f122e8d0')

build() {
    # The archive's top-level directory, named after the upstream repository, not after $pkgname.
    local srctree="$srcdir/hermes-agent-$pkgver"
    local payload="$srcdir/.build/payload"
    local products="$srcdir/.build/products"

    # Keep the build's toolchain staging and every cache it writes inside the build directory:
    # PM provisions its own pinned uv and would otherwise write into the building user's ~/.hermes.
    export HOME="$srcdir/.build/home"
    export HERMES_RUNTIME_DIR="$srcdir/.build/tools"
    mkdir -p "$HOME" "$products" "$payload"

    # Fixed-prefix layout, the shape the vendor builds for its own Docker image and Termux
    # package: code tree, venv and built products side by side, with launchers that resolve
    # their root from their own location and are therefore relocatable to /opt by package().
    # Left out: the Electron desktop app's sources (apps/), the docs site (website/), the test
    # and eval suites, the packaging recipes belonging to other distributions, and the web and
    # TUI sources -- a prebuilt install runs hermes_cli/web_dist and hermes_cli/tui_dist
    # instead. The desktop app's built form is added to the payload further down.
    tar -C "$srctree" -cf - \
        --exclude='./apps' --exclude='./tests' --exclude='./tests-js' --exclude='./evals' \
        --exclude='./website' --exclude='./.github' --exclude='./nix' --exclude='./docker' \
        --exclude='./web' --exclude='./ui-tui' \
        --exclude='./node_modules' --exclude='./.build' --exclude='./__pycache__' \
        . | tar -C "$payload" -xf -

    # PM owns the locked Python environment and provisions its pinned installer itself, so the
    # build needs no uv on the host. `all` is the vendor's own composite extra; the rest are the
    # optional features a user would otherwise have to install into a read-only /opt tree by hand.
    # pm is imported out of the checkout, so every python call below runs with it on sys.path.
    cd "$srctree"
    CMAKE_POLICY_VERSION_MINIMUM=3.5 \
        /usr/bin/python3 -m pm.build_env --source "$srctree" --python /usr/bin/python3 \
        --out "$payload/venv" --sealed \
        --extra all --extra messaging --extra anthropic --extra edge-tts --extra ddgs \
        --extra doc-extract --extra feishu --extra matrix --extra dingtalk --extra wecom \
        --extra teams --extra google-chat

    # PM's independent dependency graph. The assembler needs one to bind the runtime to, and it
    # is deliberately not shipped: its marker points at the copied /usr/bin/python3, which cannot
    # satisfy the containment check pm/runtime.py applies to a packaged install. At run time PM
    # stages its own copy under ~/.hermes on first use, exactly as it does for a source install
    # made by the vendor's own install.sh.
    /usr/bin/python3 -m pm.build_env --source "$srctree/pm" --python /usr/bin/python3 \
        --out "$srcdir/.build/pm-runtime" --manager-runtime
    /usr/bin/python3 - "$srcdir/.build/pm-runtime" <<'EOF'
import json
import sys
from pathlib import Path

runtime = Path(sys.argv[1])
sites = list(runtime.glob("lib/python*/site-packages"))
if len(sites) != 1:
    raise SystemExit(f"PM runtime dependency directory missing or ambiguous: {runtime}")
# The staged marker is an empty placeholder; the assembler wants real, resolvable paths.
(runtime / "pm-runtime.json").write_text(json.dumps(
    {"python": "bin/python", "sitePackages": sites[0].relative_to(runtime).as_posix()}
))
EOF

    # Frontend products, compiled exactly as the vendor's Docker image compiles them.
    node "$srctree/scripts/build/node-deps.mjs" --source "$srctree" --workspace ui-tui --workspace web \
        --workspace apps/desktop
    "$payload/venv/bin/python" "$srctree/scripts/generate_icons.py" --source "$srctree" \
        --out "$products/icons"
    node "$srctree/scripts/build/tui.mjs" --source "$srctree" --out "$products/tui"
    node "$srctree/scripts/build/web.mjs" --source "$srctree" --icons "$products/icons" --out "$products/web"

    # The desktop app. electron-builder's unpacked Linux output is what `hermes desktop
    # --skip-build` looks for, so it ships as built rather than being rebuilt on first click
    # (which would mean a gigabyte of downloads and a C++ toolchain at run time).
    cd "$srctree/apps/desktop"
    export CFLAGS CXXFLAGS CPPFLAGS LDFLAGS
    npm run build
    npm run builder -- --linux --dir
    cd "$srctree"

    install -d "$payload/apps/desktop"
    install -Dm644 "$srctree/apps/desktop/package.json" "$payload/apps/desktop/package.json"
    cp -a "$srctree/apps/desktop/release" "$payload/apps/desktop/release"
    # electron-updater would otherwise replace this pacman-managed app with whatever GitHub
    # releases, which is not pacman's business.
    rm -f "$payload/apps/desktop/release/linux-unpacked/resources/app-update.yml"

    # The release tarball carries no .git, so the provenance stamp takes the tag's commit from
    # the remote. Without a commit hermes reports its own version as "unknown".
    local commit
    commit="$(git ls-remote "$url.git" "refs/tags/v$pkgver^{}" | cut -f1)"
    if [ -z "$commit" ]; then
        commit="$(git ls-remote "$url.git" "refs/tags/v$pkgver" | cut -f1)"
    fi
    "$payload/venv/bin/python" "$srctree/scripts/write_install_stamp.py" \
        --output "$srcdir/.build/install-stamp.json" --commit "$commit" --branch main \
        --base-version "$pkgver" --distance 0 --source local --update-mechanism external

    /usr/bin/python3 - "$srctree" "$srcdir/.build" "$payload" "$products" "$commit" \
        "$srcdir/.build/agent-inputs.json" <<'EOF'
import json
import sys
import sysconfig
from pathlib import Path

source, build, payload, products = (Path(value) for value in sys.argv[1:5])
ref, out = sys.argv[5], Path(sys.argv[6])
venv = payload / "venv"
environment = {"base": str(venv), "platbase": str(venv)}
out.write_text(json.dumps({
    "project": str(source / "pyproject.toml"),
    "code": str(payload),
    "repo": ".",
    "placement": "fixed",
    "target": "linux-x64",
    "python": str(venv / "bin/python"),
    "site_packages": sysconfig.get_path("purelib", vars=environment),
    "environment": str(venv),
    "pm_runtime": str(build / "pm-runtime"),
    "bin_dir": "libexec",
    "resources": {name: str(source / name) for name in
                  ("skills", "optional-skills", "plugins", "locales", "optional-mcps")},
    "frontends": {"tui": str(products / "tui"), "web": str(products / "web")},
    "stamp": str(build / "install-stamp.json"),
    "ref": ref,
}, indent=2))
EOF
    "$payload/venv/bin/python" -m scripts.build.agent \
        --inputs "$srcdir/.build/agent-inputs.json" --out "$payload"
}

check() {
    # A silently missing product or extra only surfaces when a user runs the feature, so prove
    # both here: the built bundles, and every optional dependency group the package claims.
    local payload="$srcdir/.build/payload"

    test -s "$payload/hermes_cli/web_dist/index.html"
    test -s "$payload/hermes_cli/tui_dist/entry.js"
    test -x "$payload/venv/bin/python"
    test -x "$payload/apps/desktop/release/linux-unpacked/Hermes"
    test -s "$payload/apps/desktop/release/linux-unpacked/resources/app.asar"

    "$payload/venv/bin/python" -c '
import anthropic, defusedxml, ddgs, edge_tts, lark_oapi, mautrix
import hermes_cli.main
' "$payload"
}

package() {
    local srctree="$srcdir/hermes-agent-$pkgver"
    local stage="$srcdir/.build/payload"
    local payload="$pkgdir/opt/$pkgname"

    install -d "$pkgdir/opt"
    mv "$stage" "$payload"

    # Self-update block:
    # `hermes update` and `hermes uninstall` would replace or delete the pacman-owned install tree.
    install -Dm755 "$srcdir/hermes-wrapper.sh" "$pkgdir/usr/bin/hermes"
    ln -s "/opt/$pkgname/libexec/hermes-agent" "$pkgdir/usr/bin/hermes-agent"
    ln -s "/opt/$pkgname/libexec/hermes-acp" "$pkgdir/usr/bin/hermes-acp"

    # `--skip-build` uses the packaged Electron bundle; env vars belong in the launcher, not the desktop entry.
    install -Dm755 "$srcdir/hermes-desktop.sh" "$pkgdir/usr/bin/hermes-desktop"
    # Same desktop id as `hermes desktop` writes under ~/.local so one grid entry can shadow the other.
    install -Dm644 "$srcdir/com.nousresearch.hermes.desktop" \
        "$pkgdir/usr/share/applications/com.nousresearch.hermes.desktop"
    # The artwork is 1024x1024, so the themed directory has to say so or the shell scales it.
    install -Dm644 "$srctree/apps/desktop/assets/icon.png" "$pkgdir/usr/share/icons/hicolor/1024x1024/apps/hermes.png"

    # Completions are best-effort: only the shells that produced output get a file.
    local shell
    for shell in bash zsh fish; do
        HOME="$srcdir/.build/home" "$payload/libexec/hermes" completion "$shell" \
            > "$srcdir/.build/completion.$shell" 2>/dev/null || true
    done
    if [ -s "$srcdir/.build/completion.bash" ]; then
        install -Dm644 "$srcdir/.build/completion.bash" "$pkgdir/usr/share/bash-completion/completions/hermes"
    fi
    if [ -s "$srcdir/.build/completion.zsh" ]; then
        install -Dm644 "$srcdir/.build/completion.zsh" "$pkgdir/usr/share/zsh/site-functions/_hermes"
    fi
    if [ -s "$srcdir/.build/completion.fish" ]; then
        install -Dm644 "$srcdir/.build/completion.fish" "$pkgdir/usr/share/fish/vendor_completions.d/hermes.fish"
    fi

    install -Dm644 "$srctree/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
