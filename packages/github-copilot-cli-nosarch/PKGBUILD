# Maintainer: NosArch
#
# nosarch-upstream: github github/copilot-cli

pkgname=github-copilot-cli-nosarch
pkgdesc="GitHub Copilot CLI - Copilot coding agent in your terminal"
pkgver=1.0.95
pkgrel=1
url="https://github.com/github/copilot-cli"
license=('LicenseRef-GitHub-Copilot-CLI')

arch=('x86_64')
depends=('bash' 'gcc-libs' 'glibc')
provides=('copilot' 'github-copilot-cli')
conflicts=('copilot' 'github-copilot-cli' 'github-copilot-cli-bin' 'github-copilot-cli-legacy')
options=('!strip' '!debug')
source=(
    "$pkgname-$pkgver.tar.gz::https://github.com/github/copilot-cli/releases/download/v$pkgver/copilot-linux-x64.tar.gz"
    "LICENSE.md::https://raw.githubusercontent.com/github/copilot-cli/v$pkgver/LICENSE.md"
)
sha256sums=(
    'c91a8874f3b2bdc905c2452f9d9fc923013924feb431e256eb769ff792719d7f'
    'c694e2d9b3f3bb40704ca9bdc823dc90269999ab4c013dfd8a52c407046074b4'
)

build() {
    "$srcdir/copilot" completion bash > "$srcdir/copilot.bash" || true
    "$srcdir/copilot" completion zsh > "$srcdir/_copilot" || true
    "$srcdir/copilot" completion fish > "$srcdir/copilot.fish" || true
}

package() {
    install -Dm755 "$srcdir/copilot" "$pkgdir/opt/$pkgname/copilot"

    # Self-update block.
    # COPILOT_AUTO_UPDATE=false is GitHub's documented switch for stopping auto-updates, and it is load-bearing because
    # on every ordinary invocation the binary otherwise resolves a newer cached package under `~/.cache/copilot/pkg`
    # and runs that instead of the bundled one, so an auto-downloaded update takes over from pacman.
    #
    # `copilot update` is refused by name because it ignores the variable entirely: with COPILOT_AUTO_UPDATE=false it
    # still contacts GitHub and reports the latest release. The name check is the only thing that stops it.
    #
    # The TUI's `/update` slash command cannot be blocked, but it is harmless here anyway. It downloads its package
    # into the user cache, but a launch with the variable set ignores any newer cached package and runs the bundled
    # one, which is what keeps pacman's version authoritative. Its attempt to replace process.execPath is aimed at this
    # package's root-owned /opt binary and fails with EACCES, which the CLI reports rather than acting on.
    install -Dm755 /dev/stdin "$pkgdir/usr/bin/copilot" <<'EOF'
#!/bin/sh
case "${1:-}" in
    update)
        echo "copilot update is blocked: this install is managed by pacman (github-copilot-cli-nosarch)." >&2
        echo "Update or remove the package with pacman instead." >&2
        exit 1
        ;;
esac

export COPILOT_AUTO_UPDATE=false
exec /opt/github-copilot-cli-nosarch/copilot "$@"
EOF

    if [[ -s "$srcdir/copilot.bash" ]]; then
        install -Dm644 "$srcdir/copilot.bash" "$pkgdir/usr/share/bash-completion/completions/copilot"
    fi
    if [[ -s "$srcdir/_copilot" ]]; then
        install -Dm644 "$srcdir/_copilot" "$pkgdir/usr/share/zsh/site-functions/_copilot"
    fi
    if [[ -s "$srcdir/copilot.fish" ]]; then
        install -Dm644 "$srcdir/copilot.fish" "$pkgdir/usr/share/fish/vendor_completions.d/copilot.fish"
    fi

    install -Dm644 "$srcdir/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
