# Maintainer: NosArch
#
# nosarch-upstream: github anomalyco/opencode

pkgname=opencode-desktop-nosarch
pkgdesc="Open source AI coding agent desktop app"
pkgver=1.18.35
pkgrel=1
url="https://opencode.ai"
license=('MIT')

arch=('x86_64')
depends=('alsa-lib' 'at-spi2-core' 'gtk3' 'hicolor-icon-theme' 'libayatana-appindicator' 'libnotify'
         'libsecret' 'libxss' 'libxtst' 'nss' 'util-linux-libs' 'xdg-utils')
provides=('opencode-desktop')
conflicts=('opencode-desktop' 'opencode-desktop-bin' 'opencode-desktop-electron' 'opencode-desktop-electron-bin')
options=('!strip' '!debug')
source=(
    "$pkgname-$pkgver.deb::https://github.com/anomalyco/opencode/releases/download/v$pkgver/opencode-desktop-linux-amd64.deb"
    "LICENSE::https://raw.githubusercontent.com/anomalyco/opencode/v$pkgver/LICENSE"
)
sha256sums=(
    '2243bff81e3ac08605fe8a2aff022f3f581cfd2ef07136a3f7cc32cb9fc74fa6'
    '625f0f619133f89bbbb2abe37369613dfa1885eba1e50d02170deb62bb42cb6b'
)

package() {
    # Preserving upstream's FHS layout: /opt/OpenCode, the desktop entries, hicolor icons, metainfo and changelog.
    bsdtar -xf "$srcdir/$pkgname-$pkgver.deb" -C "$srcdir"
    bsdtar -xf "$srcdir/data.tar.xz" -C "$pkgdir"

    # The deb's postinst never runs under pacman, which creates the launcher symlink.
    # Named `opencode-desktop` rather than upstream's `ai.opencode.desktop`
    install -d "$pkgdir/usr/bin"
    ln -s /opt/OpenCode/ai.opencode.desktop "$pkgdir/usr/bin/opencode-desktop"

    # Upstream's executable is named "ai.opencode.desktop", and running the desktop entry with `uwsm app` passes its
    # Exec line verbatim. uwsm takes any argument ending in ".desktop" for a desktop entry file, so it tries to parse
    # the ELF as one and fails. Launch through the suffix-free /usr/bin symlink instead. The binary itself keeps its
    # name, so StartupWMClass= and Icon= still match it.
    sed --in-place 's|^Exec=/opt/OpenCode/ai\.opencode\.desktop|Exec=opencode-desktop|' \
        "$pkgdir"/usr/share/applications/*.desktop

    # Best-effort self-update block: electron-updater reads this feed and would replace the
    # pacman-managed install. With the feed gone it finds no update source.
    rm -f "$pkgdir/opt/OpenCode/resources/app-update.yml"

    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
