# Maintainer: NosArch
#
# nosarch-upstream: regex https://downloads.claude.ai/claude-desktop/apt/stable/dists/stable/main/binary-amd64/Packages [\s\S]*claude-desktop_([0-9][0-9.]*)_amd64\.deb
#
# regex directive used because the `Packages` file is just text, not a webpage for a browser

pkgname=claude-desktop-nosarch
pkgdesc="Official Claude AI desktop app from Anthropic — Chat, Cowork, and Claude Code"
pkgver=3.1623.1
pkgrel=1
url="https://claude.com/download"
license=('LicenseRef-Proprietary')

arch=('x86_64')
depends=('alsa-lib' 'at-spi2-core' 'bubblewrap' 'cairo' 'dbus' 'expat' 'gcc-libs' 'glib2'
         'glibc' 'gtk3' 'hicolor-icon-theme' 'libcap-ng' 'libcups' 'libdrm' 'libnotify'
         'libpipewire' 'libseccomp' 'libsecret' 'libx11' 'libxcb' 'libxcomposite'
         'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr' 'libxtst' 'mesa'
         'nspr' 'nss' 'pango' 'socat' 'systemd-libs' 'util-linux-libs' 'virtiofsd'
         'xdg-desktop-portal' 'xdg-utils' 'qemu-system-x86' 'edk2-ovmf')
optdepends=('gnome-keyring: credential storage via Secret Service (GNOME)'
            'kwallet: credential storage (KDE Plasma)'
            'libayatana-appindicator: system tray icon'
            'openssh: system SSH client for remote sessions'
            'xdg-desktop-portal-gtk: portal backend for GTK desktops'
            'xdg-desktop-portal-kde: portal backend for KDE Plasma')
options=('!strip' '!debug')
provides=('claude-desktop')
conflicts=('claude' 'claude-desktop' 'claude-desktop-bin')
source=(
    "claude-desktop.sh"
    "$pkgname-$pkgver.deb::https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop/claude-desktop_${pkgver}_amd64.deb"
)
sha256sums=('2b50c019e70b263750255c446bab8db6ab1e50c7396d37ef6547cf118131da65'
            '731677d2f39b2a7343ee381ec5d3396dd28ec1d832cfcb1f9e4a022e9e80eadb')

package() {
    # Unpack the Debian payload with libarchive, preserving upstream's FHS layout.
    bsdtar -xf "$srcdir/$pkgname-$pkgver.deb" -C "$srcdir"
    bsdtar -xf "$srcdir/data.tar.xz" -C "$pkgdir"

    # Replace upstream's bare symlink with a launcher that selects the Wayland backend when appropriate
    # and honours claude-desktop-flags.conf.
    rm -f "$pkgdir/usr/bin/claude-desktop"
    install -Dm755 "$srcdir/claude-desktop.sh" "$pkgdir/usr/bin/claude-desktop"

    # Chromium's setuid sandbox helper.
    chmod 4755 "$pkgdir/usr/lib/claude-desktop/chrome-sandbox"

    # lintian is Debian's linter; unused on Arch.
    rm -rf "$pkgdir/usr/share/lintian"

    # Cowork compatibility shims: map Debian paths to Arch install locations.
    ln -s ../lib/virtiofsd "$pkgdir/usr/bin/virtiofsd"

    install -d "$pkgdir/usr/share/edk2"
    ln -s x64/OVMF_CODE.4m.fd "$pkgdir/usr/share/edk2/OVMF_CODE_4M.fd"
    ln -s x64/OVMF_VARS.4m.fd "$pkgdir/usr/share/edk2/OVMF_VARS_4M.fd"

    install -Dm644 "$pkgdir/usr/share/doc/claude-desktop/copyright" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
