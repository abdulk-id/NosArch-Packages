# Maintainer: NosArch
#
# nosarch-upstream: json https://static.devin.ai/cli/current/manifest.json version

pkgname=devin-cli-nosarch
pkgdesc="Command-line interface for Devin, Cognition's AI software engineer"
pkgver=3000.11.3
pkgrel=3
url="https://devin.ai/cli"
license=('LicenseRef-Devin-CLI')

arch=('x86_64')
depends=()
optdepends=(
    'git: repository integration'
    'bubblewrap: sandboxed exec (--sandbox)'
    'socat: sandboxed exec port forwarding (--sandbox)'
    'openssh: devin ssh into cloud sessions'
)
options=('!strip' '!debug')
provides=('devin-cli')
conflicts=('devin-cli' 'devin-cli-bin')
source=(
    "$pkgname-$pkgver.tar.gz::https://static.devin.ai/cli/$pkgver/devin-$pkgver-x86_64-unknown-linux.tar.gz"
    "devin-wrapper.sh"
    "distribution"
    "LICENSE-README"
)
sha256sums=('83b3b113c01bf2a3e9e100db08d77e6b086806a7754f091e20831bdfe215157e'
            '00cca6838d84bc2f685656fea4834b8636939c478db03d3f25d62be9b5148015'
            '1627d4ffbdaec9053a7e0ed5f756294ceb1bb30f61e6fecc48fbc110a9b01d31'
            '6b7863bf7e08af71193495d790ea7a9c8e59c8d0ad1bdad744975096311a0064')

package() {
    # Keep the vendor tree intact: devin resolves its install root from its own executable path
    # and reads share/devin/docs (and the distribution marker below) as siblings of bin/.
    install -d "$pkgdir/opt/$pkgname"
    cp -a --no-preserve=ownership "$srcdir/bin" "$srcdir/share" "$pkgdir/opt/$pkgname/"

    # Self-update block:
    # The distribution marker silences the built-in updater; the wrapper refuses `devin update` and `uninstall`.
    install -Dm644 "$srcdir/distribution" "$pkgdir/opt/$pkgname/distribution"
    install -Dm755 "$srcdir/devin-wrapper.sh" "$pkgdir/usr/bin/devin"

    rm -rf "$pkgdir/opt/$pkgname/share/man"
    install -d "$pkgdir/usr/share/man/man1"
    install -m644 "$srcdir"/share/man/man1/*.1 "$pkgdir/usr/share/man/man1/"

    install -Dm644 "$srcdir/LICENSE-README" "$pkgdir/usr/share/licenses/$pkgname/README"
}
