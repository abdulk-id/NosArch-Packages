# Maintainer: NosArch
#
# nosarch-upstream: github can1357/oh-my-pi

pkgname=omp-nosarch
pkgdesc="omp - a coding agent with the IDE wired in"
pkgver=18.10.4
pkgrel=2
url="https://omp.sh"
license=('MIT')

arch=('x86_64')
depends=('glibc')
optdepends=(
    'git: repository integration'
    'python: python tool execution (omp setup python)'
    'chromium: browser tooling and the browser prelude'
    'sshfs: mounts over ssh for the bash tool'
    'alsa-lib: speech output (omp setup speech)'
    'libpulse: speech output over pulseaudio (omp setup speech)'
    'xdg-desktop-portal: browser and file chooser portals'
)
options=('!strip' '!debug')
provides=('oh-my-pi')
conflicts=('oh-my-pi' 'oh-my-pi-bin')
source=(
    "$pkgname-$pkgver::https://github.com/can1357/oh-my-pi/releases/download/v$pkgver/omp-linux-x64"
    "LICENSE::https://github.com/can1357/oh-my-pi/releases/download/v$pkgver/LICENSE"
    "THIRD-PARTY-NOTICES.txt::https://github.com/can1357/oh-my-pi/releases/download/v$pkgver/THIRD-PARTY-NOTICES.txt"
    "omp-wrapper.sh"
)
sha256sums=('ff59fc1b484c1308a7247ad208305005627b3fac62b440737c2b1835ac32074e'
            '16c45f9d667442781f03fa198914cc39abcaa48ec5ed8f644643e554ca2fbf63'
            '768612d40a4d1788813b997b011290d0f08c426add452de6560bf227cd1fc29d'
            'fb8671506993d5febdc8143b2e57812f93807c026bd2ed74568f148705a2a052')

build() {
    chmod +x "$srcdir/$pkgname-$pkgver"

    "$srcdir/$pkgname-$pkgver" completions bash > "$srcdir/omp.bash" || true
    "$srcdir/$pkgname-$pkgver" completions zsh > "$srcdir/_omp" || true
    "$srcdir/$pkgname-$pkgver" completions fish > "$srcdir/omp.fish" || true
}

package() {
    install -Dm755 "$srcdir/$pkgname-$pkgver" "$pkgdir/opt/$pkgname/omp"

    # Self-update block:
    # `omp update` would overwrite the pacman-managed launcher in PATH; `omp update --plugins` still runs.
    install -Dm755 "$srcdir/omp-wrapper.sh" "$pkgdir/usr/bin/omp"

    if [[ -s "$srcdir/omp.bash" ]]; then
        install -Dm644 "$srcdir/omp.bash" "$pkgdir/usr/share/bash-completion/completions/omp"
    fi
    if [[ -s "$srcdir/_omp" ]]; then
        install -Dm644 "$srcdir/_omp" "$pkgdir/usr/share/zsh/site-functions/_omp"
    fi
    if [[ -s "$srcdir/omp.fish" ]]; then
        install -Dm644 "$srcdir/omp.fish" "$pkgdir/usr/share/fish/vendor_completions.d/omp.fish"
    fi

    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/THIRD-PARTY-NOTICES.txt" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES.txt"
}
