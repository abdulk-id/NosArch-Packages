# Maintainer: NosArch
#
# nosarch-upstream: github imputnet/helium-linux

pkgname=helium-browser-nosarch
pkgdesc="Private, fast, and honest web browser based on Chromium"
pkgver=0.19.4.1
pkgrel=1
url="https://github.com/imputnet/helium-linux"
license=('GPL-3.0-only AND BSD-3-Clause')

arch=('x86_64' 'aarch64')
depends=('alsa-lib' 'dbus' 'gtk3' 'hicolor-icon-theme' 'libcups' 'libpulse' 'libva'
         'libxss' 'nss' 'ttf-liberation' 'udev' 'xdg-utils')
optdepends=('pipewire: WebRTC desktop sharing under Wayland'
            'kdialog: support for native dialogs in Plasma'
            'org.freedesktop.secrets: password storage backend on GNOME / Xfce'
            'kwallet: support for storing passwords in KWallet on Plasma'
            'qt5-base: support for Qt themes'
            'upower: Battery Status API support')
options=('!strip' '!debug')
provides=('helium-browser')
conflicts=('helium-browser' 'helium-browser-bin' 'helium-browser-beta-bin')
source=(
    "0001-update-wrapper-arch.patch"
    "LICENSE::https://raw.githubusercontent.com/imputnet/helium-linux/$pkgver/LICENSE"
    "LICENSE.ungoogled_chromium::https://raw.githubusercontent.com/imputnet/helium-linux/$pkgver/LICENSE.ungoogled_chromium"
)
source_x86_64=(
    "$pkgname-$pkgver-x86_64_linux.tar.xz::https://github.com/imputnet/helium-linux/releases/download/$pkgver/helium-$pkgver-x86_64_linux.tar.xz"
)
source_aarch64=(
    "$pkgname-$pkgver-arm64_linux.tar.xz::https://github.com/imputnet/helium-linux/releases/download/$pkgver/helium-$pkgver-arm64_linux.tar.xz"
)
sha256sums=(
    '3846be557da5202267fc4d8a45572f4cedcd95e82d4e62e998c4486fed311314'
    'a0279a9937ce228eb71ea2a0252d0830458708570fee3df516fa4bd4c8a134bc'
    '9539b394e4179952698894bd62ef6566b6804ab0ff360dcf3a511cfaf7f78c4d'
)
sha256sums_x86_64=(
    '6ca6e4a00fef5916821fb1af8a9607cc6b386f678a7eb422e55f19116ba30469'
)
sha256sums_aarch64=(
    '63137674429e2f94bb03b65b254de0af3f6440a95ea6067a4d7c0cd63ac9cf96'
)

prepare() {
    _archdir="helium-${pkgver}-$([[ $CARCH == aarch64 ]] && echo arm64 || echo x86_64)_linux"

    patch -d "$srcdir/$_archdir" -p1 -i "$srcdir/0001-update-wrapper-arch.patch"
}

package() {
    _archdir="helium-${pkgver}-$([[ $CARCH == aarch64 ]] && echo arm64 || echo x86_64)_linux"

    install -dm755 "$pkgdir/opt/$pkgname"
    cp -a "$srcdir/$_archdir/"* "$pkgdir/opt/$pkgname/"

    install -Dm644 "$srcdir/$_archdir/helium.desktop" "$pkgdir/usr/share/applications/helium.desktop"

    # Align the desktop entry with the helium-browser wrapper/binary name.
    sed --in-place \
        -e 's/^Name=Helium$/Name=Helium Browser/' \
        -e 's/^Exec=helium %U$/Exec=helium-browser %U/' \
        -e 's/^Icon=helium$/Icon=helium-browser/' \
        -e 's/^Exec=helium$/Exec=helium-browser/' \
        -e 's/^Exec=helium --incognito$/Exec=helium-browser --incognito/' \
        "$pkgdir/usr/share/applications/helium.desktop"

    install -Dm644 "$pkgdir/opt/$pkgname/product_logo_256.png" "$pkgdir/usr/share/pixmaps/helium-browser.png"
    install -Dm644 "$pkgdir/opt/$pkgname/product_logo_256.png" \
        "$pkgdir/usr/share/icons/hicolor/256x256/apps/helium-browser.png"

    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/LICENSE.ungoogled_chromium" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE.ungoogled_chromium"

    install -dm755 "$pkgdir/usr/bin"
    ln -sf "/opt/$pkgname/helium-wrapper" "$pkgdir/usr/bin/helium-browser"
}
